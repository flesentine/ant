{
  "schema_version": 1,
  "id": "P4_external_validation_collection_activation_checklist_v1",
  "status": "frozen_before_biological_collection",
  "purpose": "Final prospective checklist to convert the fail-closed preauthorization into active biological collection authorization without changing any preregistered scientific contract.",
  "must_all_be_true_before_first_trial": [
    "collector_identity_is_real_nonempty_and_frozen",
    "collector_team_or_affiliation_is_recorded",
    "all_collector_independence_attestations_are_true",
    "all_12_colony_husbandry_records_are_complete_and_valid",
    "all_12_colony_source_nest_ids_are_distinct",
    "marked_side_schedule_blob_is_unchanged",
    "release_pose_schedule_manifest_and_all_part_blobs_are_unchanged",
    "chemical_batch_template_blob_is_unchanged",
    "colony_husbandry_template_blob_is_unchanged",
    "video_calibration_template_blob_is_unchanged",
    "trial_record_schema_blob_is_unchanged",
    "chemical_session_batch_binding_is_enforced",
    "per_trial_fresh_substrate_and_cleaning_fields_and_enforcement_are_frozen",
    "worker_assay_naivety_field_and_enforcement_are_frozen",
    "no_biological_collection_has_started",
    "no_new_biological_outcome_has_been_accessed",
    "candidate_307_prediction_has_not_been_disclosed_to_collector",
    "activation_regression_passes_on_exact_head",
    "fresh_codex_review_is_clean_on_exact_head",
    "activation_commit_is_qualified_on_permanent_main"
  ],
  "activation_may_change": [
    "collector_identity_and_affiliation_fields",
    "collector_independence_attestations_from_null_to_true",
    "collector_identity_frozen_from_false_to_true",
    "prospective_colony_husbandry_records_from_absent_to_complete",
    "authorization_status_from_pending_to_active",
    "collection_authorized_from_false_to_true",
    "prospective_activation_metadata_and_qualification_ids"
  ],
  "activation_may_not_change": [
    "preregistration",
    "Candidate_307_parameters_or_prediction",
    "marked_side_schedule",
    "release_pose_schedule",
    "apparatus_or_stimulus_contract",
    "wet_lab_recipe",
    "environment_or_husbandry_contract",
    "endpoint_translation",
    "sample_size",
    "quality_thresholds",
    "statistical_comparison_or_promotion_rule"
  ]
}
